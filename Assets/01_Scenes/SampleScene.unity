  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChatManager
  _npcNameText: {fileID: 1380287686466347463}
  _npcDialogueText: {fileID: 5327324259232196947}
  _userPromptIF: {fileID: 3277141945185690600}
  _sendButton: {fileID: 3735651344470413467}
  _rag: "\uC544\uB974\uCE74\uB204\uC2A4\uAC00 \uC9C0\uD0A4\uB294 \uB9C8\uBC95 \uB3C4\uC11C\uAD00\uC740 '\uBCC4\uBE5B \uD0D1' \uCD5C\uC0C1\uCE35\uC5D0 \uC788\uC73C\uBA70 300\uB144 \uC804 \uC138\uC6CC\uC84C\uB2E4. \uC804\uC124\uC758 \uAC80 '\uC5EC\uBA85\uAC80'\uC740 \uB3C4\uC11C\uAD00 \uC9C0\uD558 \uBD09\uC778\uC2E4\uC5D0 \uC7A0\uB4E4\uC5B4 \uC788\uC73C\uBA70, \uC624\uC9C1 \uC21C\uC218\uD55C \uB9C8\uC74C\uC744 \uAC00\uC9C4 \uC790\uB9CC \uBF51\uC744 \uC218 \uC788\uB2E4. \uAE08\uC9C0\uB41C \uB9C8\uBC95 '\uC2DC\uAC04 \uC5ED\uD589'\uC740 \uC81C7\uC11C\uAC00\uC5D0 \uBD09\uC778\uB418\uC5B4 \uC788\uACE0, \uC0AC\uC6A9\uD558\uBA74 \uC2DC\uC804\uC790\uC758 \uAE30\uC5B5\uC744 \uB300\uAC00\uB85C \uAC00\uC838\uAC04\uB2E4. \uB3C4\uC11C\uAD00\uC758 \uC218\uD638 \uC815\uB839 '\uB8E8\uBA58'\uC740 \uBC24\uC5D0\uB9CC \uB098\uD0C0\uB098 \uAE38 \uC783\uC740 \uBC29\uBB38\uC790\uB97C \uC548\uB0B4\uD55C\uB2E4. \uBD81\uCABD \uC124\uC6D0\uC758 \uC5BC\uC74C \uC6A9 '\uD504\uB85C\uC2A4\uD2F0\uC544'\uB294 200\uB144\uC9F8 \uC7A0\uB4E4\uC5B4 \uC788\uC73C\uBA70, \uAE68\uC5B4\uB098\uBA74 \uC655\uAD6D\uC774 \uC5BC\uC5B4\uBD99\uB294\uB2E4\uACE0 \uC804\uD574\uC9C4\uB2E4."
  _history: []
